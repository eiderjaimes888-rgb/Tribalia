<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Tribalia | Ecosistema de Software Contable y Herramientas con IA' %></title>
  <meta name="description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Tribalia Soluciones Informáticas S.A.S. Software contable con Inteligencia Artificial, herramientas tributarias, nómina, compliance y gestión empresarial.' %>">
  <link rel="icon" type="image/svg+xml" href="/img/logos/tribalia-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;1,800&family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tribalia.css?v=2.0">
</head>
<body>

  <header class="site-header">
    <div class="container nav-wrapper">
      <a href="/" class="brand-logo" aria-label="Tribalia Inicio">
        <img src="/img/logos/tribalia-logo.svg" alt="Tribalia" style="height:72px;width:auto;">
      </a>

      <ul class="nav-menu" id="navMenu">
        <li class="nav-item"><a href="/" class="nav-link" data-i18n="nav_home">Inicio</a></li>
        <li class="nav-item has-dropdown">
          <span class="nav-link" data-i18n="nav_products">Productos <span style="font-size:0.65rem;">▼</span></span>
          <ul class="dropdown-menu" id="navProductsDropdown"></ul>
        </li>
        <li class="nav-item"><a href="/quienes-somos" class="nav-link" data-i18n="nav_about">Quiénes Somos</a></li>
        <li class="nav-item"><a href="/#noticias" class="nav-link" data-i18n="nav_news">Noticias</a></li>
        <li class="nav-item"><a href="/#revista" class="nav-link" data-i18n="nav_magazine">Revista</a></li>
        <li class="nav-item"><a href="/tienda" class="nav-link" data-i18n="nav_store">Tienda</a></li>
        <li class="nav-item"><a href="/#contacto" class="nav-link" data-i18n="nav_contact">Contacto</a></li>
      </ul>

      <div class="nav-actions">
        <button type="button" class="lang-btn" id="langBtn">EN</button>
        <div class="nav-item has-dropdown">
          <button type="button" class="btn btn-primary" style="padding: 9px 16px;" data-i18n="btn_access">Acceso Aplicaciones ▾</button>
          <ul class="dropdown-menu dropdown-menu--right" id="navAccessDropdown"></ul>
        </div>
        <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </header>
