<%- include('partials/header') %>

  <section class="section section--white" style="padding-top:56px;">
    <div class="container" style="max-width:860px;">
      <div style="margin-bottom:24px;">
        <a href="/#noticias" class="btn btn-outline">← Volver a Noticias</a>
      </div>
      <span class="section-eyebrow"><%= article.tag %></span>
      <h1 class="section-title" style="margin-bottom:10px;"><%= article.title %></h1>
      <p style="color:var(--gris-suave);margin-bottom:24px;">Publicado el <%= new Date(article.published_at || article.created_at).toLocaleDateString('es-CO') %></p>

      <% if (article.cover_image_path) { %>
      <img src="<%= article.cover_image_path %>" alt="<%= article.title %>" style="width:100%;max-height:420px;object-fit:cover;border-radius:18px;margin-bottom:28px;border:1px solid var(--border-light);">
      <% } %>

      <% if (article.summary) { %>
      <p style="font-size:1.12rem;font-weight:600;color:var(--azul-noche);margin-bottom:20px;"><%= article.summary %></p>
      <% } %>

      <div style="font-size:1.02rem;line-height:1.8;white-space:pre-line;"><%= article.content %></div>
    </div>
  </section>

<%- include('partials/footer') %>
